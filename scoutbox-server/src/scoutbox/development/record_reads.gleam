//// What the player reads about their own record (domains/development/record.mjs): the feed, the CV and the drill
//// library. All three are read from the record and the Discovery Ledger, and write nothing.

import gleam/json.{type Json}
import gleam/list
import gleam/option.{type Option, None, Some}
import scoutbox/app.{type Ctx}
import scoutbox/development/benchmarks
import scoutbox/discovery/insights
import scoutbox/identity/access.{type PlayerAccess}
import scoutbox/identity/players.{type Media}
import scoutbox/platform/clock
import scoutbox/platform/http
import scoutbox/platform/json_text
import scoutbox/platform/store
import scoutbox/rows/player_drill_results as drill_result_row
import scoutbox/rules/journey
import wisp.{type Response}

const feed_events = 8

const cv_note =
  "Generated by ScoutBox. Attendance is GPS+device verified; trial reports are filed by clubs; trust is never purchasable."

/// `GET /player/feed`: the week's report, the latest scouting events, and the tags scouts gave the clips.
pub fn feed(ctx: Ctx, p: PlayerAccess) -> Response {
  let now = clock.now_ms()
  let player = p.player
  case
    store.read(ctx.store, insights.for_feed(_, player.row.id, now, feed_events))
  {
    Error(failure) -> http.internal(failure)
    Ok(#(views, shortlists, recent)) -> {
      let report =
        json.object([
          #("type", json.string("weekly_report")),
          #("ts", json.int(now)),
          #(
            "report",
            json.object([
              #("views", json.int(views)),
              #("shortlists", json.int(shortlists)),
              #("streak", json.int(journey.streak(player.activity_log, now))),
              #("weeklyGoal", journey.weekly_goal(player.activity_log, now)),
              #("topClip", json.nullable(top_clip(player.media), clip_json)),
              #("suggestion", case journey.next_action_list(player) {
                [first, ..] -> first
                [] -> json.null()
              }),
            ]),
          ),
        ])
      let events =
        list.map(recent, fn(e: insights.Event) {
          json.object([
            #("type", json.string("scouting_event")),
            #("ts", json.int(e.at)),
            #("orgName", json.nullable(e.org_name, json.string)),
            #("eventType", json.string(e.kind)),
          ])
        })
      let noticed = case noticed(player.media) {
        [] -> []
        tags -> [
          json.object([
            #("type", json.string("scouts_noticed")),
            #("ts", json.int(now - 1)),
            #(
              "tags",
              json.object(list.map(tags, fn(t) { #(t.0, json.int(t.1)) })),
            ),
          ]),
        ]
      }
      http.json(
        200,
        json.preprocessed_array([report, ..list.append(events, noticed)]),
      )
    }
  }
}

/// The most-viewed clip; the first of those tied.
fn top_clip(media: List(Media)) -> Option(Media) {
  list.fold(media, None, fn(best: Option(Media), m: Media) {
    case best {
      Some(b) if b.clip.views >= m.clip.views -> best
      _ -> Some(m)
    }
  })
}

fn clip_json(m: Media) -> Json {
  json.object([
    #("title", json.string(m.clip.title)),
    #("views", json.int(m.clip.views)),
    #("verified", json.bool(m.clip.verified_clip_attendance_id != None)),
  ])
}

/// Every clip's tags summed, in the order each tag first appears.
fn noticed(media: List(Media)) -> List(#(String, Int)) {
  list.fold(media, [], fn(acc, m) {
    list.fold(m.tags, acc, fn(acc, tag) {
      let #(name, n) = tag
      case list.key_find(acc, name) {
        Ok(had) -> list.key_set(acc, name, had + n)
        Error(Nil) -> list.append(acc, [#(name, n)])
      }
    })
  })
}

/// `GET /player/cv`.
pub fn cv(p: PlayerAccess) -> Response {
  let now = clock.now_ms()
  let player = p.player
  let r = player.row
  let score = players.profile_signal(player)
  http.json(
    200,
    json.object([
      #("generatedAt", json.string(clock.iso(now))),
      #(
        "player",
        json.object([
          #("name", json.string(r.name)),
          #("age", json.int(players.age_now(player, now))),
          #("country", json.string(r.country)),
          #("position", self_field(player, "position")),
          #("foot", self_field(player, "foot")),
          #("heightCm", json.nullable(r.height_cm, json.int)),
          #("weightKg", json.nullable(r.weight_kg, json.int)),
          #("identityVerified", json.bool(r.identity_verified)),
        ]),
      ),
      #(
        "trust",
        json.object([
          #("score", json.int(score)),
          #("tier", json.string(journey.tier(score))),
          #("breakdown", players.trust_breakdown(player)),
        ]),
      ),
      #("seasonStats", players.stats_json(players.stats(r))),
      #(
        "verifiedAttendance",
        json.array(player.attendance, fn(a) {
          json.object(
            list.flatten([
              [#("fixture", json.string(a.fixture))],
              present("venue", a.venue, json.string),
              [#("date", json.string(a.match_date))],
            ]),
          )
        }),
      ),
      #(
        "verifiedClips",
        player.media
          |> list.filter(fn(m) { m.clip.verified_clip_attendance_id != None })
          |> json.array(fn(m) {
            json.object(
              list.flatten([
                [#("title", json.string(m.clip.title))],
                present("uploadedAt", m.clip.uploaded_at, json.string),
              ]),
            )
          }),
      ),
      #(
        "trialReports",
        json.array(player.trial_reports, fn(t) {
          json.object([
            #("orgName", json.nullable(t.org_name, json.string)),
            #("filedAt", json.int(t.filed_at)),
            #("acceleration", json_text.number(t.acceleration)),
            #("sprintSpeedKmh", json_text.number(t.sprint_speed_kmh)),
            #("distanceKm", json_text.number(t.distance_km)),
            #("passCompletionPct", json_text.number(t.pass_completion_pct)),
            #("duelSuccessPct", json_text.number(t.duel_success_pct)),
            #("coachRating", json_text.number(t.coach_rating)),
          ])
        }),
      ),
      #("combine", json.array(player.drill_results, players.drill_result_json)),
      #("timeline", json.array(player.timeline, players.timeline_json)),
      #("note", json.string(cv_note)),
    ]),
  )
}

/// A field of the player's own record, written as `/player/me` writes it.
fn self_field(p: players.Player, name: String) -> Json {
  case list.key_find(players.self_fields(p), name) {
    Ok(v) -> v
    Error(Nil) -> json.null()
  }
}

fn present(
  name: String,
  v: Option(a),
  to_json: fn(a) -> Json,
) -> List(#(String, Json)) {
  case v {
    Some(v) -> [#(name, to_json(v))]
    None -> []
  }
}

/// `GET /player/drills`: the library, with whether the player has done each and their best result.
pub fn drills(p: PlayerAccess) -> Response {
  let player = p.player
  http.json(
    200,
    json.array(benchmarks.drills, fn(d) {
      json.object([
        #("id", json.string(d.id)),
        #("name", json.string(d.name)),
        #("metric", json.string(d.metric)),
        #("unit", json.string(d.unit)),
        #("benchmark", json_text.number(d.benchmark)),
        #("lowerIsBetter", json.bool(d.lower_is_better)),
        #("completed", json.bool(list.contains(player.drills, d.id))),
        #(
          "best",
          json.nullable(
            best(player.drill_results, d),
            players.drill_result_json,
          ),
        ),
      ])
    }),
  )
}

/// The best result of a drill; the earliest of those tied.
fn best(
  results: List(drill_result_row.Row),
  d: benchmarks.Drill,
) -> Option(drill_result_row.Row) {
  list.fold(
    results,
    None,
    fn(best: Option(drill_result_row.Row), r: drill_result_row.Row) {
      case r.drill_id == d.id, best {
        False, _ -> best
        True, None -> Some(r)
        True, Some(b) ->
          case
            d.lower_is_better
            && r.value <. b.value
            || !d.lower_is_better
            && r.value >. b.value
          {
            True -> Some(r)
            False -> best
          }
      }
    },
  )
}
