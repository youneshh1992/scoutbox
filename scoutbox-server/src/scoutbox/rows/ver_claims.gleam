    sqlight.nullable(sqlight.text, row.note),
    sqlight.nullable(sqlight.text, row.representation_id),
    sqlight.nullable(sqlight.text, row.document_reviewed),
    sqlight.nullable(sqlight.text, row.assigned_to),
    sqlight.nullable(sqlight.int, row.expiry_warned_at),
  ]
}

pub fn insert(tx: Tx, row: Row) -> Result(Nil, Fail(e)) {
  store.run(tx, insert_sql, values(row))
}
