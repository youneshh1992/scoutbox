    sqlight.nullable(sqlight.int, row.recorded_at),
    sqlight.nullable(sqlight.int, row.responded_at),
    sqlight.nullable(
      fn(v) { sqlight.text(response_kind_to_string(v)) },
      row.response_kind,
    ),
    sqlight.nullable(sqlight.text, row.response_message),
    sqlight.nullable(
      fn(v) { sqlight.text(party.to_string(v)) },
      row.response_by,
    ),
    sqlight.nullable(sqlight.int, row.response_at),
    sqlight.nullable(sqlight.int, row.cancelled_at),
    sqlight.nullable(id.org_user_sql, row.cancelled_by_user_id),
    sqlight.nullable(sqlight.text, row.cancelled_by_name),
    sqlight.nullable(sqlight.text, row.create_key),
    sqlight.nullable(sqlight.text, row.create_fp),
    sqlight.nullable(sqlight.text, row.send_key),
    sqlight.nullable(sqlight.text, row.send_fp),
    sqlight.nullable(sqlight.text, row.record_key),
    sqlight.nullable(sqlight.text, row.record_fp),
    sqlight.int(row.rev),
    sqlight.nullable(sqlight.int, row.rev_at),
    sqlight.nullable(id.org_user_sql, row.rev_by_user_id),
    sqlight.nullable(sqlight.text, row.rev_by_name),
    sqlight.int(row.policy_version),
  ]
}

pub fn insert(tx: Tx, row: Row) -> Result(Nil, Fail(e)) {
  store.run(tx, insert_sql, values(row))
}
