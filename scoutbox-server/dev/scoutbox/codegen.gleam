//// The row modules, generated from the migrated schema. `generate` applies the migrations to an in-memory
//// database, asks SQLite what it made, and renders one module per table:
////
//// - `Row`: every column, typed. `CHECK (col IN ('a', 'b'))` makes an enum, `CHECK (col IN (0, 1))` a Bool, a
////   nullable column an `Option`.
//// - `decoder()`, reading `columns` in order; `qualified(alias)` for the same list in a join.
//// - `insert(tx, row)` with `insert_sql` and `values(row)`. When the table has columns SQLite fills itself (an
////   `INTEGER PRIMARY KEY` rowid, a generated column), the insert takes a `New` without them.
////
//// A vocabulary several tables share is declared once (`Shared`) and rendered as its own module under
//// `scoutbox/vocab/`; a column whose CHECK lists exactly a shared vocabulary's values uses it. Every other
//// vocabulary is an enum in its table's module.
////
//// Ids are typed. A table declared with `Ided` has an opaque `<Name>Id` in `scoutbox/rows/id`, and every
//// column holding one of its ids is typed with it: the table's own `id`, a column whose foreign key names that
//// table, or a column `IdColumns` maps to it. A column named `id` or `*_id` that none of these place must be
//// declared `Untyped`, with the reason, or the generator refuses it, so a new id column is always decided.
////
//// The output is plain text: `npm run codegen` writes it and runs `gleam format` over it.

import gleam/dict.{type Dict}
import gleam/dynamic/decode
import gleam/int
import gleam/list
import gleam/option.{None, Some}
import gleam/regexp
import gleam/result
import gleam/set.{type Set}
import gleam/string
import sqlight

/// A vocabulary shared by several tables: the module `scoutbox/vocab/<snake name>` holds its type.
pub type Shared {
  Shared(name: String, values: List(String))
}

/// A table whose ids are typed: `<name>Id` in `scoutbox/rows/id`, minted with `prefix` when it has one.
pub type Ided {
  Ided(table: String, name: String, prefix: option.Option(String))
}

/// How an id column with no foreign key to an `Ided` table is typed. `column` is `table.column`, or `column`
/// for that name in every table.
pub type IdColumn {
  /// The column holds ids of `table`.
  RefersTo(column: String, table: String)
  /// The column stays `String`: polymorphic (its kind is in another column), or an id this server can't type.
  Untyped(column: String, reason: String)
}

pub type Generated {
  Generated(module: String, source: String)
}

type Kind {
  Text
  Integer
  Real
  Boolean
  /// An enum in the table's own module.
  Local(type_name: String, values: List(String))
  /// A shared vocabulary's module.
  SharedKind(Shared)
  /// An id of a table declared `Ided`.
  IdKind(Ided)
}

type Column {
  Column(
    name: String,
    kind: Kind,
    nullable: Bool,
    automatic: Bool,
    /// The column's DEFAULT, as SQL text.
    default: option.Option(String),
  )
}

const header =
  "//// Generated by `npm run codegen` from priv/migrations. Don't edit: change the migration and regenerate.\n"

/// The modules for `tables` of `schema` (the migrations' SQL, concatenated): the shared vocabularies, then the
/// tables. Only the tables this server uses get a module; the schema holds every table the TypeScript server has.
pub fn generate(
  schema: String,
  shared: List(Shared),
  tables wanted: List(String),
  ided ided: List(Ided),
  id_columns id_columns: List(IdColumn),
) -> List(Generated) {
  use conn <- sqlight.with_connection(":memory:")
  let assert Ok(_) = sqlight.exec(schema, conn)
  let assert Ok(tables) =
    sqlight.query(
      "SELECT name, sql FROM sqlite_master WHERE type = 'table' AND name NOT LIKE 'sqlite_%' ORDER BY name",
      conn,
      [],
      {
        use name <- decode.field(0, decode.string)
        use sql <- decode.field(1, decode.string)
        decode.success(#(name, sql))
      },
    )
  case list.find(wanted, fn(w) { !list.any(tables, fn(t) { t.0 == w }) }) {
    Ok(missing) -> panic as { "table " <> missing <> " is not in the schema" }
    Error(Nil) -> Nil
  }
  let tables = list.filter(tables, fn(t) { list.contains(wanted, t.0) })
  let described =
    list.map(tables, fn(t) {
      #(t.0, describe(conn, t.0, t.1, shared, ided, id_columns))
    })
  let used =
    described
    |> list.flat_map(fn(t) { t.1 })
    |> list.filter_map(fn(c) {
      case c.kind {
        SharedKind(s) -> Ok(s.name)
        _ -> Error(Nil)
      }
    })
    |> set.from_list
  case list.find(shared, fn(s) { !set.contains(used, s.name) }) {
    Ok(unused) ->
      panic as {
        "shared vocabulary "
        <> unused.name
        <> " matches no column: its values must be exactly one column's CHECK list"
      }
    Error(Nil) -> Nil
  }
  list.append(
    [
      Generated("scoutbox/rows/id", render_ids(ided)),
      ..list.map(shared, fn(s) {
        Generated("scoutbox/vocab/" <> snake(s.name), render_shared(s))
      })
    ],
    list.map(described, fn(t) {
      Generated("scoutbox/rows/" <> t.0, render_table(t.0, t.1))
    }),
  )
}

// ------------------------------------------------------------------------------------------ the schema

fn describe(
  conn: sqlight.Connection,
  table: String,
  sql: String,
  shared: List(Shared),
  ided: List(Ided),
  id_columns: List(IdColumn),
) -> List(Column) {
  let checks = in_checks(sql)
  let assert Ok(foreign) =
    sqlight.query(
      // Only a key to the other table's `id` makes an id column (not one to a composite key).
      "SELECT \"from\", \"table\" FROM pragma_foreign_key_list(?) WHERE coalesce(\"to\", 'id') = 'id'",
      conn,
      [sqlight.text(table)],
      {
        use from <- decode.field(0, decode.string)
        use to <- decode.field(1, decode.string)
        decode.success(#(from, to))
      },
    )
  let assert Ok(rows) =
    sqlight.query(
      "SELECT name, type, \"notnull\", pk, hidden, dflt_value FROM pragma_table_xinfo(?) ORDER BY cid",
      conn,
      [sqlight.text(table)],
      {
        use name <- decode.field(0, decode.string)
        use type_ <- decode.field(1, decode.string)
        use not_null <- decode.field(2, sqlight.decode_bool())
        use pk <- decode.field(3, decode.int)
        use hidden <- decode.field(4, decode.int)
        use default <- decode.field(5, decode.optional(decode.string))
        decode.success(#(name, type_, not_null, pk, hidden, default))
      },
    )
  let pk_columns = list.count(rows, fn(r) { r.3 > 0 })
  list.map(rows, fn(row) {
    let #(name, type_, not_null, pk, hidden, default) = row
    let kind = case dict.get(checks, name), type_ {
      Ok(values), "INTEGER" ->
        case list.sort(values, string.compare) {
          ["0", "1"] -> Boolean
          _ -> Integer
        }
      Ok(values), "TEXT" ->
        case
          list.find(shared, fn(s) {
            list.sort(s.values, string.compare)
            == list.sort(list.unique(values), string.compare)
          })
        {
          Ok(s) -> SharedKind(s)
          Error(Nil) -> Local(local_type_name(name), list.unique(values))
        }
      _, "TEXT" -> id_kind(table, name, foreign, ided, id_columns)
      _, "INTEGER" -> Integer
      _, "REAL" -> Real
      _, other ->
        panic as { table <> "." <> name <> ": no mapping for " <> other }
    }
    // An INTEGER PRIMARY KEY is the rowid: SQLite numbers it. Generated columns (hidden 2 and 3) can't be
    // written. STRICT makes PRIMARY KEY columns NOT NULL.
    let rowid = pk == 1 && pk_columns == 1 && type_ == "INTEGER"
    Column(
      name:,
      kind:,
      nullable: !not_null && pk == 0,
      automatic: rowid || hidden >= 2,
      default:,
    )
  })
}

/// The type of a TEXT column with no vocabulary: an id type when it holds an `Ided` table's ids, else `Text`.
fn id_kind(
  table: String,
  column: String,
  foreign: List(#(String, String)),
  ided: List(Ided),
  id_columns: List(IdColumn),
) -> Kind {
  let here = table <> "." <> column
  let ided_for = fn(t: String, why: String) {
    case list.find(ided, fn(i) { i.table == t }) {
      Ok(i) -> IdKind(i)
      Error(Nil) ->
        panic as {
          here
          <> " holds ids of "
          <> t
          <> " ("
          <> why
          <> "): declare "
          <> t
          <> " as Ided, or the column as Untyped"
        }
    }
  }
  let declared =
    list.find(id_columns, fn(d) { d.column == here })
    |> result.lazy_or(fn() {
      list.find(id_columns, fn(d) { d.column == column })
    })
  case declared, list.key_find(foreign, column) {
    Ok(Untyped(..)), _ -> Text
    Ok(RefersTo(_, to)), _ -> ided_for(to, "IdColumns")
    Error(Nil), Ok(to) -> ided_for(to, "its foreign key")
    Error(Nil), Error(Nil) ->
      case column == "id", string.ends_with(column, "_id") {
        True, _ -> ided_for(table, "its own id")
        _, True ->
          panic as {
            here
            <> " looks like an id but nothing types it: add a foreign key, or declare it in IdColumns (RefersTo or Untyped)"
          }
        False, False -> Text
      }
  }
}

fn local_type_name(column: String) -> String {
  case pascal(column) {
    // The row module's own names, and the prelude's types, which a local type would shadow.
    "Row"
    | "New"
    | "List"
    | "Result"
    | "Bool"
    | "Int"
    | "Float"
    | "String"
    | "Nil"
    | "BitArray"
    | "UtfCodepoint" -> pascal(column) <> "Value"
    name -> name
  }
}

/// `col IN ('a', 'b')` and `col IN (0, 1)` checks, found in each column's own definition, so a check that
/// mentions another column (`detail_x IS NULL OR type IN (…)`) is not mistaken for that column's vocabulary.
///
/// A table-level CHECK can still make a column a Bool (`delivered IN (0, 1)` inside a CHECK over several columns),
/// but never a vocabulary.
fn in_checks(sql: String) -> Dict(String, List(String)) {
  let definitions = column_definitions(sql)
  let assert Ok(boolean) =
    regexp.from_string("\\b\"?(\\w+)\"?\\s+IN\\s*\\(\\s*0\\s*,\\s*1\\s*\\)")
  let table_level =
    definitions
    |> list.filter(string.starts_with(_, "CHECK"))
    |> list.flat_map(regexp.scan(boolean, _))
    |> list.filter_map(fn(m) {
      case m.submatches {
        [Some(column)] -> Ok(#(column, ["0", "1"]))
        _ -> Error(Nil)
      }
    })
  definitions
  |> list.filter(fn(d) { !string.starts_with(d, "CHECK") })
  |> list.filter_map(fn(definition) {
    let name =
      definition
      |> string.split(" ")
      |> list.first
      |> result.unwrap("")
      |> string.replace("\"", "")
    let assert Ok(re) =
      regexp.from_string("\\b\"?" <> name <> "\"?\\s+IN\\s*\\(([^)]*)\\)")
    // A CHECK may allow different lists in different cases (`(list = 'a' AND code IN (…)) OR (…)`): the
    // column's vocabulary is all of them.
    case regexp.scan(re, definition) {
      [] -> Error(Nil)
      matches ->
        Ok(#(
          name,
          matches
            |> list.flat_map(fn(m) {
              case m.submatches {
                [Some(values)] -> string.split(values, ",")
                _ -> []
              }
            })
            |> list.map(fn(v) { v |> string.trim |> string.replace("'", "") })
            |> list.unique,
        ))
    }
  })
  |> list.append(table_level)
  |> dict.from_list
}

/// The top-level, comma-separated parts of a CREATE TABLE's body, trimmed.
fn column_definitions(sql: String) -> List(String) {
  let body = case string.split_once(sql, "(") {
    Ok(#(_, rest)) -> rest
    Error(Nil) -> ""
  }
  let #(parts, current, _, _) =
    string.to_graphemes(body)
    |> list.fold(#([], "", 0, False), fn(acc, g) {
      let #(parts, current, depth, quoted) = acc
      case g, quoted {
        "'", _ -> #(parts, current <> g, depth, !quoted)
        _, True -> #(parts, current <> g, depth, quoted)
        "(", False -> #(parts, current <> g, depth + 1, quoted)
        ")", False -> #(parts, current <> g, depth - 1, quoted)
        ",", False if depth == 0 -> #([current, ..parts], "", depth, quoted)
        _, False -> #(parts, current <> g, depth, quoted)
      }
    })
  [current, ..parts]
  |> list.reverse
  |> list.map(string.trim)
}

// ----------------------------------------------------------------------------------------- rendering

/// `scoutbox/rows/id`: an opaque type per `Ided` table, with its conversions and, given a prefix, its minting.
fn render_ids(ided: List(Ided)) -> String {
  let ided = list.sort(ided, fn(a, b) { string.compare(a.name, b.name) })
  string.concat([
    header,
    "//// Each table's ids, as their own types: an id of one table can't be passed where another's is wanted.\n",
    "//// An id comes from a row's decoder, from minting (`next_…`), or from `<name>(text)` for one that arrives from\n",
    "//// outside (a path, a body, a test's literal); nothing checks that such an id exists.\n\n",
    "import gleam/dynamic/decode\nimport gleam/json.{type Json}\nimport gleam/result\n",
    "import scoutbox/platform/ids\nimport scoutbox/platform/store.{type Fail, type Tx}\nimport sqlight\n\n",
    lines(ided, fn(i) {
      let t = i.name <> "Id"
      let f = snake(i.name)
      string.concat([
        "/// An id of `",
        i.table,
        "`.\n",
        "pub opaque type ",
        t,
        " {\n  ",
        t,
        "(String)\n}\n\n",
        "/// An id from outside: a request's path or body, a test's literal.\n",
        "pub fn ",
        f,
        "(text: String) -> ",
        t,
        " {\n  ",
        t,
        "(text)\n}\n\n",
        "pub fn ",
        f,
        "_to_string(id: ",
        t,
        ") -> String {\n  let ",
        t,
        "(text) = id\n  text\n}\n\n",
        "pub fn ",
        f,
        "_sql(id: ",
        t,
        ") -> sqlight.Value {\n  sqlight.text(",
        f,
        "_to_string(id))\n}\n\n",
        "pub fn ",
        f,
        "_json(id: ",
        t,
        ") -> Json {\n  json.string(",
        f,
        "_to_string(id))\n}\n\n",
        "pub fn ",
        f,
        "_decoder() -> decode.Decoder(",
        t,
        ") {\n  decode.map(decode.string, ",
        t,
        ")\n}\n\n",
        case i.prefix {
          None -> ""
          Some(prefix) ->
            string.concat([
              "/// A new id, minted inside the unit that uses it.\n",
              "pub fn next_",
              f,
              "(tx: Tx) -> Result(",
              t,
              ", Fail(e)) {\n  ids.next(tx, ",
              quote(prefix),
              ") |> result.map(",
              t,
              ")\n}\n\n",
            ])
        },
      ])
    }),
  ])
}

fn render_shared(s: Shared) -> String {
  let type_name = s.name
  let constructors = list.map(s.values, fn(v) { #(v, constructor(v, "")) })
  string.concat([
    header,
    "\n",
    "import gleam/dynamic/decode\nimport gleam/json.{type Json}\n\n",
    render_enum(type_name, constructors, ""),
  ])
}

/// An enum's type, its text pairs (`pairs`, for input checks), and conversions. `prefix` names the functions
/// (`status_` in a table module, nothing in a vocabulary's own module).
fn render_enum(
  type_name: String,
  constructors: List(#(String, String)),
  prefix: String,
) -> String {
  let assert [#(_, first), ..] = constructors
  string.concat([
    "pub type ",
    type_name,
    " {\n",
    lines(constructors, fn(c) { "  " <> c.1 <> "\n" }),
    "}\n\n",
    "/// Each value with the text the column stores.\n",
    "pub const ",
    prefix,
    "pairs = [",
    list.map(constructors, fn(c) { "#(" <> quote(c.0) <> ", " <> c.1 <> ")" })
      |> string.join(", "),
    "]\n\n",
    "pub fn ",
    prefix,
    "to_string(value: ",
    type_name,
    ") -> String {\n  case value {\n",
    lines(constructors, fn(c) { "    " <> c.1 <> " -> " <> quote(c.0) <> "\n" }),
    "  }\n}\n\n",
    "pub fn ",
    prefix,
    "from_string(value: String) -> Result(",
    type_name,
    ", Nil) {\n  case value {\n",
    lines(constructors, fn(c) {
      "    " <> quote(c.0) <> " -> Ok(" <> c.1 <> ")\n"
    }),
    "    _ -> Error(Nil)\n  }\n}\n\n",
    "/// The text the column stores, as JSON.\n",
    "pub fn ",
    prefix,
    "to_json(value: ",
    type_name,
    ") -> Json {\n  json.string(",
    prefix,
    "to_string(value))\n}\n\n",
    "/// Text outside the vocabulary fails loudly: the table's CHECK should make it impossible.\n",
    "pub fn ",
    prefix,
    "decoder() -> decode.Decoder(",
    type_name,
    ") {\n  use value <- decode.then(decode.string)\n  case ",
    prefix,
    "from_string(value) {\n    Ok(v) -> decode.success(v)\n    Error(Nil) -> decode.failure(",
    first,
    ", ",
    quote(type_name),
    ")\n  }\n}\n\n",
  ])
}

fn render_table(table: String, columns: List(Column)) -> String {
  let locals =
    list.filter_map(columns, fn(c) {
      case c.kind {
        Local(type_name, values) -> Ok(#(type_name, values))
        _ -> Error(Nil)
      }
    })
  let clashing = clashing_values(locals)
  let shared_modules =
    list.filter_map(columns, fn(c) {
      case c.kind {
        SharedKind(s) -> Ok(snake(s.name))
        _ -> Error(Nil)
      }
    })
    |> list.unique
    |> list.sort(string.compare)
  let has_new = list.any(columns, fn(c) { c.automatic })
  let written = list.filter(columns, fn(c) { !c.automatic })
  let names = list.map(columns, fn(c) { c.name })
  let written_names = list.map(written, fn(c) { c.name })
  let insert_type = case has_new {
    True -> "New"
    False -> "Row"
  }
  let imports =
    list.flatten([
      ["gleam/dynamic/decode"],
      case locals {
        [] -> []
        _ -> ["gleam/json.{type Json}"]
      },
      ["gleam/list"],
      case
        list.any(columns, fn(c) { c.nullable }),
        list.any(written, fn(c) { c.nullable && c.default == None }),
        list.any(written, fn(c) { c.nullable && c.default != None })
      {
        False, _, _ -> []
        True, False, False -> ["gleam/option.{type Option}"]
        True, True, False -> ["gleam/option.{type Option, None}"]
        True, False, True -> ["gleam/option.{type Option, Some}"]
        True, True, True -> ["gleam/option.{type Option, None, Some}"]
      },
      ["gleam/string"],
      case list.any(columns, fn(c) { is_id(c.kind) }) {
        True -> [
          "scoutbox/platform/store.{type Fail, type Tx}",
          "scoutbox/rows/id",
        ]
        False -> ["scoutbox/platform/store.{type Fail, type Tx}"]
      },
      list.map(shared_modules, fn(m) { "scoutbox/vocab/" <> m }),
      ["sqlight"],
    ])
  string.concat([
    header,
    "\n",
    lines(imports, fn(i) { "import " <> i <> "\n" }),
    "\n",
    "pub const table = ",
    quote(table),
    "\n\n",
    "/// Every column, in `Row` order.\n",
    "pub const columns = ",
    quote(string.join(names, ", ")),
    "\n\n",
    "/// How many columns `columns` names: an extra column selected after them is read at this index.\n",
    "pub const width = ",
    int.to_string(list.length(names)),
    "\n\n",
    "/// `columns`, each prefixed with `alias.`, for a join.\n",
    "pub fn qualified(alias: String) -> String {\n  columns\n  |> string.split(\", \")\n  |> list.map(fn(c) { alias <> \".\" <> c })\n  |> string.join(\", \")\n}\n\n",
    lines(locals, fn(l) {
      render_enum(
        l.0,
        list.map(l.1, fn(v) { #(v, local_constructor(l.0, v, clashing)) }),
        snake(l.0) <> "_",
      )
    }),
    "pub type Row {\n  Row(\n",
    lines(columns, fn(c) {
      "    " <> field(c.name) <> ": " <> gleam_type(c) <> ",\n"
    }),
    "  )\n}\n\n",
    case has_new {
      False -> ""
      True ->
        string.concat([
          "/// A row to insert: `Row` without the columns SQLite fills itself.\n",
          "pub type New {\n  New(\n",
          lines(written, fn(c) {
            "    " <> field(c.name) <> ": " <> gleam_type(c) <> ",\n"
          }),
          "  )\n}\n\n",
        ])
    },
    render_new(insert_type, written, clashing),
    "/// Reads `columns`, in order.\n",
    "pub fn decoder() -> decode.Decoder(Row) {\n",
    lines(list.index_map(columns, fn(c, i) { #(c, i) }), fn(pair) {
      let #(c, i) = pair
      "  use "
      <> field(c.name)
      <> " <- decode.field("
      <> int.to_string(i)
      <> ", "
      <> decoder_of(c)
      <> ")\n"
    }),
    "  decode.success(Row(",
    list.map(columns, fn(c) { field(c.name) <> ":" }) |> string.join(", "),
    "))\n}\n\n",
    "pub const insert_sql = ",
    quote(
      "INSERT INTO "
      <> table
      <> " ("
      <> string.join(written_names, ", ")
      <> ") VALUES ("
      <> string.join(list.map(written, fn(_) { "?" }), ", ")
      <> ")",
    ),
    "\n\n",
    "/// The values `insert_sql` binds, in its order.\n",
    "pub fn values(row: ",
    insert_type,
    ") -> List(sqlight.Value) {\n  [\n",
    lines(written, fn(c) { "    " <> value_of(c) <> ",\n" }),
    "  ]\n}\n\n",
    "pub fn insert(tx: Tx, row: ",
    insert_type,
    ") -> Result(Nil, Fail(e)) {\n  store.run(tx, insert_sql, values(row))\n}\n",
  ])
}

/// `new(…)`: a row to insert from its required columns. A nullable column starts as `None` and a defaulted one
/// at its DEFAULT; change them with a record update.
fn render_new(
  insert_type: String,
  written: List(Column),
  clashing: Set(String),
) -> String {
  let filled = list.map(written, fn(c) { #(c, default_literal(c, clashing)) })
  let required = list.filter(filled, fn(f) { f.1 == None })
  string.concat([
    "/// A `",
    insert_type,
    "` from its required columns: the nullable ones are `None`, the defaulted ones their DEFAULT.\n",
    "pub fn new(",
    list.map(required, fn(f) {
      field({ f.0 }.name)
      <> " "
      <> field({ f.0 }.name)
      <> ": "
      <> gleam_type(f.0)
    })
      |> string.join(", "),
    ") -> ",
    insert_type,
    " {\n  ",
    insert_type,
    "(",
    list.map(filled, fn(f) {
      case f.1 {
        None -> field({ f.0 }.name) <> ":"
        Some(literal) -> field({ f.0 }.name) <> ": " <> literal
      }
    })
      |> string.join(", "),
    ")\n}\n\n",
  ])
}

/// The Gleam value a column starts at in `new`, or `None` when the caller must give it.
fn default_literal(c: Column, clashing: Set(String)) -> option.Option(String) {
  let literal = case c.default {
    None -> Error(Nil)
    Some(sql) -> {
      let text = case
        string.starts_with(sql, "'") && string.ends_with(sql, "'")
      {
        True -> Ok(sql |> string.drop_start(1) |> string.drop_end(1))
        False -> Error(Nil)
      }
      case c.kind, sql, text {
        Boolean, "0", _ -> Ok("False")
        Boolean, "1", _ -> Ok("True")
        Integer, _, _ -> int.parse(sql) |> result.map(int.to_string)
        Text, _, Ok(t) -> Ok(quote(t))
        Local(type_name, values), _, Ok(t) ->
          case list.contains(values, t) {
            True -> Ok(local_constructor(type_name, t, clashing))
            False -> Error(Nil)
          }
        SharedKind(shared), _, Ok(t) ->
          case list.contains(shared.values, t) {
            True -> Ok(snake(shared.name) <> "." <> constructor(t, ""))
            False -> Error(Nil)
          }
        _, _, _ -> Error(Nil)
      }
    }
  }
  case literal, c.nullable {
    Ok(l), True -> Some("Some(" <> l <> ")")
    Ok(l), False -> Some(l)
    Error(Nil), True -> Some("None")
    Error(Nil), False -> None
  }
}

fn gleam_type(c: Column) -> String {
  let base = case c.kind {
    Text -> "String"
    Integer -> "Int"
    Real -> "Float"
    Boolean -> "Bool"
    Local(type_name, _) -> type_name
    SharedKind(s) -> snake(s.name) <> "." <> s.name
    IdKind(i) -> "id." <> i.name <> "Id"
  }
  case c.nullable {
    True -> "Option(" <> base <> ")"
    False -> base
  }
}

fn decoder_of(c: Column) -> String {
  let base = case c.kind {
    Text -> "decode.string"
    Integer -> "decode.int"
    Real -> "decode.float"
    Boolean -> "sqlight.decode_bool()"
    Local(type_name, _) -> snake(type_name) <> "_decoder()"
    SharedKind(s) -> snake(s.name) <> ".decoder()"
    IdKind(i) -> "id." <> snake(i.name) <> "_decoder()"
  }
  case c.nullable {
    True -> "decode.optional(" <> base <> ")"
    False -> base
  }
}

fn value_of(c: Column) -> String {
  let value = "row." <> field(c.name)
  let to_text = case c.kind {
    Local(type_name, _) -> Some(snake(type_name) <> "_to_string")
    SharedKind(s) -> Some(snake(s.name) <> ".to_string")
    _ -> None
  }
  let encoder = case c.kind, to_text {
    IdKind(i), _ -> "id." <> snake(i.name) <> "_sql"
    _, Some(f) -> "fn(v) { sqlight.text(" <> f <> "(v)) }"
    Text, None -> "sqlight.text"
    Integer, None -> "sqlight.int"
    Real, None -> "sqlight.float"
    _, None -> "sqlight.bool"
  }
  case c.nullable, to_text {
    True, _ -> "sqlight.nullable(" <> encoder <> ", " <> value <> ")"
    False, Some(f) -> "sqlight.text(" <> f <> "(" <> value <> "))"
    False, None -> encoder <> "(" <> value <> ")"
  }
}

fn is_id(kind: Kind) -> Bool {
  case kind {
    IdKind(_) -> True
    _ -> False
  }
}

fn lines(items: List(a), render: fn(a) -> String) -> String {
  list.map(items, render) |> string.concat
}

fn quote(s: String) -> String {
  "\""
  <> string.replace(s, "\\", "\\\\") |> string.replace("\"", "\\\"")
  <> "\""
}

// --------------------------------------------------------------------------------------------- names

/// Values in two enums of one table: their constructors get the type's name as a prefix, because Gleam
/// constructors share the module's namespace. `Row` and `New` are taken too, and so are the prelude's `Ok`,
/// `Error` and option's `Some` and `None`, which the module uses.
fn clashing_values(enums: List(#(String, List(String)))) -> Set(String) {
  let #(_, twice) =
    enums
    |> list.flat_map(fn(e) { list.map(e.1, constructor(_, "")) })
    |> list.append(list.flatten(list.repeat(taken, 2)))
    |> list.fold(#(set.new(), set.new()), fn(acc, name) {
      case set.contains(acc.0, name) {
        True -> #(acc.0, set.insert(acc.1, name))
        False -> #(set.insert(acc.0, name), acc.1)
      }
    })
  twice
}

const taken = ["Row", "New", "Ok", "Error", "Some", "None"]

fn local_constructor(
  type_name: String,
  value: String,
  clashing: Set(String),
) -> String {
  let plain = constructor(value, "")
  case set.contains(clashing, plain) {
    True -> constructor(value, type_name)
    False -> plain
  }
}

/// `dev-outbox` → `DevOutbox`, `org_user` → `OrgUser`, `NO_SUCH_THING` → `NoSuchThing`, `LICENCE` → `Licence`,
/// `GK` stays `GK`. A
/// value that would not start with a letter takes `prefix` (or `V`).
fn constructor(value: String, prefix: String) -> String {
  let assert Ok(non_word) = regexp.from_string("[^A-Za-z0-9]+")
  let parts = regexp.split(non_word, value) |> list.filter(fn(p) { p != "" })
  let name =
    parts
    |> list.map(fn(part) {
      // A short lone upper-case word is an abbreviation (`GK`, `CDM`); anything else upper-case is words.
      case string.uppercase(part) == part, parts, string.length(part) <= 3 {
        True, [_], True -> part
        _, _, _ -> string.capitalise(part)
      }
    })
    |> string.concat
  let assert Ok(starts_with_letter) = regexp.from_string("^[A-Z]")
  case prefix, regexp.check(starts_with_letter, name) {
    "", True -> name
    "", False -> "V" <> name
    _, _ -> prefix <> name
  }
}

const keywords = [
  "as", "assert", "auto", "case", "const", "delegate", "derive", "echo", "else",
  "fn", "if", "implement", "import", "let", "macro", "opaque", "panic", "pub",
  "test", "todo", "type", "use",
]

fn field(column: String) -> String {
  case list.contains(keywords, column) {
    True -> column <> "_"
    False -> column
  }
}

fn pascal(name: String) -> String {
  name |> string.split("_") |> list.map(string.capitalise) |> string.concat
}

pub fn snake(type_name: String) -> String {
  type_name
  |> string.to_graphemes
  |> list.index_map(fn(g, i) {
    case string.lowercase(g) == g, i {
      True, _ -> g
      False, 0 -> string.lowercase(g)
      False, _ -> "_" <> string.lowercase(g)
    }
  })
  |> string.concat
}
