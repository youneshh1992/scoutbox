# ScoutBox backend — all values optional in local development.
# Copy to .env and export, or pass inline. NEVER commit real secrets.

# Port the API listens on (default 4000).
PORT=4000

# 'production' disables seeded passwordless demo logins; there is no override.
NODE_ENV=development

# HMAC secret for signed media URLs. Required in production (32+ characters).
# Unset in development: a random key per process, so links expire on restart.
MEDIA_SECRET=

# Trust & Safety console key (default: scoutbox-admin — change in production).
ADMIN_KEY=

# Provider adapters: leave empty to use the built-in dev transports
# (admin outbox / push log). ID verification, billing and media storage have
# only their dev providers; no real integration exists yet.
SENDGRID_API_KEY=
EXPO_ACCESS_TOKEN=
