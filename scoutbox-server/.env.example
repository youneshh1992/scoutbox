# ScoutBox backend — all values optional in local development.
# Copy to .env and export, or pass inline. NEVER commit real secrets.

# Port the API listens on (default 4000).
PORT=4000

# 'production' disables seeded passwordless demo logins unless
# ALLOW_DEV_LOGINS=1 is set explicitly.
NODE_ENV=development
ALLOW_DEV_LOGINS=

# HMAC secret for signed media URLs. Defaults to a generated secret stored in
# the database; set explicitly for multi-instance deployments.
MEDIA_SECRET=

# Trust & Safety console key (default: scoutbox-admin — change in production).
ADMIN_KEY=

# Provider adapters: leave empty to use the built-in dev transports
# (admin outbox / push log / dev invoice ledger / local disk media).
SENDGRID_API_KEY=
EXPO_ACCESS_TOKEN=
ONFIDO_API_TOKEN=
STRIPE_SECRET_KEY=
S3_BUCKET=
