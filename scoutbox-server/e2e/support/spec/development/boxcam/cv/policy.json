{
  "$source": "domains/development/boxcam/cv/policy.mjs",
  "BOX_CAM_CV_POLICY_VERSION": 1,
  "CV_ENGINE_VERSION": 2,
  "CV_PROVIDER_ID": "production_cv",
  "FRAME_ENCODING": "gray8",
  "FRAME_LIMITS": {
    "minWidth": 160,
    "minHeight": 120,
    "maxWidth": 320,
    "maxHeight": 240,
    "maxBytes": 76800,
    "maxFramesPerBatch": 12,
    "maxBatchesPerSession": 120,
    "maxQueuedFrames": 24
  },
  "FORBIDDEN_CLIENT_FIELDS": [
    "touches",
    "touchCount",
    "reps",
    "repCount",
    "juggles",
    "juggleCount",
    "count",
    "measurement",
    "value",
    "result",
    "verified",
    "verifiedReps",
    "combineVerified",
    "confidence",
    "modelVersion",
    "providerVersion",
    "productionEligible",
    "accepted",
    "observationState",
    "score"
  ],
  "CANDIDATE_PROTOCOLS": {
    "combine-box-touch-60": {
      "eventKind": "touch",
      "requires": [
        "player_presence",
        "ball_presence",
        "rep_count"
      ],
      "note": "Discrete ball-contact events counted inside the standardised 60-second window."
    },
    "combine-box-juggle": {
      "eventKind": "juggle",
      "requires": [
        "player_presence",
        "ball_presence",
        "rep_count"
      ],
      "note": "Contact → flight → contact sequences; not vertical peak counting."
    },
    "combine-box-control-60": {
      "eventKind": "duration",
      "requires": [
        "player_presence",
        "ball_presence",
        "active_duration"
      ],
      "note": "Continuous close control. Needs no event counting — duration only."
    }
  }
}
