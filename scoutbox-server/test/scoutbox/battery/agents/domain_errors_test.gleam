import gleam/json
import gleam/option.{Some}
import scoutbox/agents/core_routes
import scoutbox/agents/transaction_routes
import scoutbox/recruitment/domain_errors
import wisp/simulate

// core: publicErrorBody — [neg] D40 error bodies are whitelisted fields only
pub fn neg_d40_error_bodies_are_whitelisted_fields_only_test() {
  assert simulate.read_body(
      domain_errors.send(core_routes.contract, "PLAYER_NOT_FOUND", [
        #("stack", json.string("x")),
        #("internal", json.string("y")),
        #("message", json.string("m")),
      ]),
    )
    == "{\"ok\":false,\"error\":\"PLAYER_NOT_FOUND\",\"message\":\"m\"}"
}

// crossApp: httpStatusFor — AO-p1 an unknown routing mode is 400: the request is wrong and the caller can fix it
pub fn ao_p1_an_unknown_routing_mode_is_400_the_request_is_wrong_and_the_caller_test() {
  assert domain_errors.status_of(
      domain_errors.lifecycle,
      "CONTACT_MODE_INVALID",
    )
    == Some(400)
}

// transactions: publicErrorBody — Z-p6 a 500 says nothing about itself
pub fn z_p6_a_500_says_nothing_about_itself_test() {
  assert simulate.read_body(
      domain_errors.send(
        transaction_routes.contract,
        "TRANSACTION_STATE_UNKNOWN",
        [#("message", json.string("internal detail"))],
      ),
    )
    == "{\"ok\":false,\"error\":\"TRANSACTION_STATE_UNKNOWN\",\"message\":\"The transaction service cannot serve this request. This has been recorded.\"}"
}
