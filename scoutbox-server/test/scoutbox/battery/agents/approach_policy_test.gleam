// adversarial: selectPolicyVersion — F2 the version in force at a date is the one selected, not simply the newest row
pub fn f2_the_version_in_force_at_a_date_is_the_one_selected_not_simply_the_new_test() {
  assert approach_policy.select_version(
      [
        approach_policy.Policy(
          row: jurisdiction_policies.Row(
            ..base.policy(),
            id: id.policy("p1"),
            jurisdiction: jurisdiction.ENG,
            policy_version: 1,
            status: jurisdiction_policies.Published,
            published_at: Some(0),
            effective_from_date: "2025-01-01",
            effective_to_date: Some("2026-01-01"),
          ),
          rules: [],
        ),
        approach_policy.Policy(
          row: jurisdiction_policies.Row(
            ..base.policy(),
            id: id.policy("p2"),
            jurisdiction: jurisdiction.ENG,
            policy_version: 2,
            status: jurisdiction_policies.Published,
            published_at: Some(0),
            effective_from_date: "2026-01-01",
            effective_to_date: None,
          ),
          rules: [],
        ),
      ],
      jurisdiction.ENG,
      1_789_862_400_000,
    )
    == Some(
      approach_policy.Policy(
        row: jurisdiction_policies.Row(
          ..base.policy(),
          id: id.policy("p2"),
          jurisdiction: jurisdiction.ENG,
          policy_version: 2,
          status: jurisdiction_policies.Published,
          published_at: Some(0),
          effective_from_date: "2026-01-01",
          effective_to_date: None,
        ),
        rules: [],
      ),
    )
}

