// adversarial: inputHashOf — G7 the conflict input hash is key-order independent and a sha256 — two recordings of the same facts compare equal
pub fn g7_the_conflict_input_hash_is_key_order_independent_and_a_sha256_two_rec_test() {
  assert conflict.hash_of(
      canonical.Object([
        #("a", canonical.Int(1)),
        #("b", canonical.Array([canonical.Int(2), canonical.Int(3)])),
        #("c", canonical.Object([#("d", canonical.Int(4))])),
      ]),
    )
    == "220d3b5786ff50882daa87d3f6a60ca2ee3d893c6b2e9c36e6c2e7bae04cf3cf"
}

