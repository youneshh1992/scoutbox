// analytics: transitions — P3 — a stage reached twice is counted once
pub fn p3_a_stage_reached_twice_is_counted_once_test() {
  assert context.transitions([
      context.Entry(
        at: 1_773_748_800_000,
        action: "room_created",
        from: None,
        to: None,
        status: Some("watching"),
      ),
      context.Entry(
        at: 1_774_612_800_000,
        action: "room_status_changed",
        from: Some("watching"),
        to: Some("under_review"),
        status: None,
      ),
      context.Entry(
        at: 1_775_476_800_000,
        action: "room_status_changed",
        from: Some("under_review"),
        to: Some("archived"),
        status: None,
      ),
      context.Entry(
        at: 1_776_340_800_000,
        action: "room_reopened",
        from: Some("archived"),
        to: Some("under_review"),
        status: None,
      ),
      context.Entry(
        at: 1_777_204_800_000,
        action: "room_status_changed",
        from: Some("under_review"),
        to: Some("shortlisted"),
        status: None,
      ),
    ])
    == [
      context.Transition(
        at: 1_774_612_800_000,
        from: Some("watching"),
        to: "under_review",
        reopen: False,
      ),
      context.Transition(
        at: 1_775_476_800_000,
        from: Some("under_review"),
        to: "archived",
        reopen: False,
      ),
      context.Transition(
        at: 1_776_340_800_000,
        from: Some("archived"),
        to: "under_review",
        reopen: True,
      ),
      context.Transition(
        at: 1_777_204_800_000,
        from: Some("under_review"),
        to: "shortlisted",
        reopen: False,
      ),
    ]
}

