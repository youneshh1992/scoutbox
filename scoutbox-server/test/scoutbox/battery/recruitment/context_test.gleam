// analytics: transitions — the opening status comes from the room’s own created entry
pub fn the_opening_status_comes_from_the_room_s_own_created_entry_test() {
  assert context.transitions([
      context.Entry(
        at: 1_776_340_800_000,
        action: "room_created",
        from: None,
        to: None,
        status: Some("watching"),
      ),
      context.Entry(
        at: 1_777_204_800_000,
        action: "room_status_changed",
        from: Some("watching"),
        to: Some("under_review"),
        status: None,
      ),
      context.Entry(
        at: 1_778_068_800_000,
        action: "room_status_changed",
        from: Some("under_review"),
        to: Some("shortlisted"),
        status: None,
      ),
    ])
    == [
      context.Transition(
        at: 1_777_204_800_000,
        from: Some("watching"),
        to: "under_review",
        reopen: False,
      ),
      context.Transition(
        at: 1_778_068_800_000,
        from: Some("under_review"),
        to: "shortlisted",
        reopen: False,
      ),
    ]
}

