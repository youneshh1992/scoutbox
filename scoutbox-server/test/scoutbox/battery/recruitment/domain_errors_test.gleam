// lifecycle: publicErrorBody — [neg] Y8 and the body a client receives names none of them — not one store, not the count
pub fn neg_y8_and_the_body_a_client_receives_names_none_of_them_not_one_store_n_test() {
  assert simulate.read_body(
      domain_errors.send(domain_errors.lifecycle, "JOURNEY_STORE_MISSING", [
        #("ok", json.bool(False)),
        #(
          "message",
          json.string(
            "The recruitment journey cannot be built: a required collection is absent or is not a list.",
          ),
        ),
        #(
          "missing",
          json.preprocessed_array([
            json.string("trials"),
            json.string("assessments"),
          ]),
        ),
        #("malformed", json.preprocessed_array([])),
      ]),
    )
    == "{\"ok\":false,\"error\":\"JOURNEY_STORE_MISSING\",\"message\":\"The recruitment journey cannot be served for this case. This has been recorded.\"}"
}

