      briefs.explain(
        briefs.Criteria(
          positions: [position.CDM, position.CM],
          min_age: Some(16),
          max_age: Some(18),
          radius_km: None,
          max_level: None,
          foot: None,
          availability: None,
          evidence_requirements: ["recent_full_match"],
