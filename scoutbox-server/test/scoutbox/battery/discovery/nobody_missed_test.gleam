      nobody_missed.order(
        [
          nobody_missed.Orderable(
            player_id: "b",
            name: Some("B"),
            distance_km: None,
            trust_band: None,
            last_evidence_at: None,
            reviewed_at: None,
          ),
          nobody_missed.Orderable(
            player_id: "a",
            name: Some("A"),
            distance_km: None,
            trust_band: None,
            last_evidence_at: None,
            reviewed_at: None,
