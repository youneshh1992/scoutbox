// combine: personalBest — personal best ignores non-verified attempts
pub fn personal_best_ignores_non_verified_attempts_test() {
  assert combine_rules.personal_best([
      combine_rules.Scored(
        measured_value: Some(171.0),
        direction: combine_attempts.Higher,
        live_state: combine_attempts.CombineVerified,
        item: Nil,
      ),
      combine_rules.Scored(
        measured_value: Some(184.0),
        direction: combine_attempts.Higher,
        live_state: combine_attempts.CombineVerified,
        item: Nil,
      ),
      combine_rules.Scored(
        measured_value: Some(999.0),
        direction: combine_attempts.Higher,
        live_state: combine_attempts.CombineStatePartiallyMeasured,
        item: Nil,
      ),
    ])
    == Some(combine_rules.Scored(
      measured_value: Some(184.0),
      direction: combine_attempts.Higher,
      live_state: combine_attempts.CombineVerified,
      item: Nil,
    ))
}

// combine: personalBest — lower-is-better direction respected
pub fn lower_is_better_direction_respected_test() {
  assert combine_rules.personal_best([
      combine_rules.Scored(
        measured_value: Some(6.9),
        direction: combine_attempts.Lower,
        live_state: combine_attempts.CombineVerified,
        item: Nil,
      ),
      combine_rules.Scored(
        measured_value: Some(6.8),
        direction: combine_attempts.Lower,
        live_state: combine_attempts.CombineVerified,
        item: Nil,
      ),
    ])
    == Some(combine_rules.Scored(
      measured_value: Some(6.8),
      direction: combine_attempts.Lower,
      live_state: combine_attempts.CombineVerified,
      item: Nil,
    ))
}

// combine: comparisonMatrix — [neg] missing comparison cell is null, never 0
pub fn neg_missing_comparison_cell_is_null_never_0_test() {
  assert json.to_string(combine_rules.comparison(
      [#("a", "A"), #("b", "B")],
      [
        {
          let assert option.Some(p) =
            combine_rules.protocol("combine-box-touch-60", 1)
          p
        },
      ],
      dict.from_list([
        #(
          "a::combine-box-touch-60@1",
          combine_rules.Cell(value: 184.0, at: Some(1)),
        ),
      ]),
    ))
    == "{\"protocols\":[{\"id\":\"combine-box-touch-60\",\"version\":1,\"title\":\"Box Touch 60\",\"metricUnit\":\"touches\",\"direction\":\"higher\"}],\"rows\":[{\"playerId\":\"a\",\"playerName\":\"A\",\"cells\":[{\"value\":184,\"display\":\"184\",\"verified\":true,\"at\":1}]},{\"playerId\":\"b\",\"playerName\":\"B\",\"cells\":[null]}],\"note\":\"Verified numbers only (✓). A blank cell means no verified result — not zero. ScoutBox does not rank players overall.\"}"
}

