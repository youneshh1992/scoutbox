// dates: normWhen — N9 year-only and month-only history dates are kept at their own precision
pub fn n9_year_only_and_month_only_history_dates_are_kept_at_their_own_precisio_test() {
  assert passport_rules.when_of("2024")
    == Some(passport_rules.When(
      t: 1_704_067_200_000,
      precision: passport_rules.Year,
    ))
}

