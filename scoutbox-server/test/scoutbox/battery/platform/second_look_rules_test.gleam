// contracts: orderSecondLook — Second Look orders by relevance kind, then the latest change, then the id — never a priority score
pub fn second_look_orders_by_relevance_kind_then_the_latest_change_then_the_id_test() {
  assert list.map(
      list.sort(
        [
          #(second_look_items.SignificantNewEvidence, 5, "sl-2"),
          #(second_look_items.SignificantNewEvidence, 5, "sl-1"),
          #(second_look_items.SignificantNewEvidence, 9, "sl-3"),
          #(second_look_items.DirectReasonResolved, 1, "sl-4"),
        ],
        second_look_rules.compare_items,
      ),
      fn(t) { t.2 },
    )
    == ["sl-4", "sl-3", "sl-1", "sl-2"]
}

