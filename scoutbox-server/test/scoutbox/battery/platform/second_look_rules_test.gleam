// productionHardening: normalizeMaterialChange — the same canonical session fingerprints identically
pub fn the_same_canonical_session_fingerprints_identically_test() {
  assert option.map(
      option.map(
        second_look_rules.normalize(
          "combine_verified_invalidated",
          "box_cam",
          Some("sess-9"),
          Some(1_700_000_000_000),
        ),
        second_look_rules.change_json,
      ),
      json.to_string,
    )
    == Some(
      "{\"type\":\"combine_verified_invalidated\",\"sourceSystem\":\"box_cam\",\"sourceId\":\"sess-9\",\"occurredAt\":1700000000000,\"negative\":true,\"text\":\"A Combine result used in the previous review is no longer valid.\",\"fingerprint\":\"combine_verified_invalidated:box_cam:sess-9\"}",
    )
}

