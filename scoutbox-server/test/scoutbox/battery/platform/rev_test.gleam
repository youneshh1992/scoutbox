    == Ok(rev.Expected(4))
}

// productionHardening: expectedRevOf — an absent token means "unchanged behaviour without a rev token", not rev 0
pub fn an_absent_token_means_unchanged_behaviour_without_a_rev_token_not_rev_0_test() {
