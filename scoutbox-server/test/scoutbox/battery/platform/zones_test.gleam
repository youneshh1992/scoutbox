// dates: localParts — F4 04:30Z on 1 March is 23:30 on 28 February in New York
pub fn f4_04_30z_on_1_march_is_23_30_on_28_february_in_new_york_test() {
  assert {
      let p =
        zones.local_parts(1_772_339_400_000, base.zone("America/New_York"))
      [p.year, p.month, p.day, p.hour, p.minute, p.second]
    }
    == [2026, 2, 28, 23, 30, 0]
}
