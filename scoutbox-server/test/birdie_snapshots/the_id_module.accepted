//// Generated by `npm run codegen` from priv/migrations. Don't edit: change the migration and regenerate.
//// Each table's ids, as their own types: an id of one table can't be passed where another's is wanted.
//// An id comes from a row's decoder, from minting (`next_…`), or from `<name>(text)` for one that arrives from
//// outside (a path, a body, a test's literal); nothing checks that such an id exists.

import gleam/dynamic/decode
import gleam/json.{type Json}
import gleam/result
import scoutbox/platform/ids
import scoutbox/platform/store.{type Fail, type Tx}
import sqlight

/// An id of `clubs`.
pub opaque type ClubId {
  ClubId(String)
}

/// An id from outside: a request's path or body, a test's literal.
pub fn club(text: String) -> ClubId {
  ClubId(text)
}

pub fn club_to_string(id: ClubId) -> String {
  let ClubId(text) = id
  text
}

pub fn club_sql(id: ClubId) -> sqlight.Value {
  sqlight.text(club_to_string(id))
}

pub fn club_json(id: ClubId) -> Json {
  json.string(club_to_string(id))
}

pub fn club_decoder() -> decode.Decoder(ClubId) {
  decode.map(decode.string, ClubId)
}

/// A new id, minted inside the unit that uses it.
pub fn next_club(tx: Tx) -> Result(ClubId, Fail(e)) {
  ids.next(tx, "club") |> result.map(ClubId)
}

