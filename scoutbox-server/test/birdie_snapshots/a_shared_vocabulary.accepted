//// Generated by `npm run codegen` from priv/migrations. Don't edit: change the migration and regenerate.

import gleam/dynamic/decode
import gleam/json.{type Json}

pub type Party {
  Player
  Guardian
}

/// Each value with the text the column stores.
pub const pairs = [#("player", Player), #("guardian", Guardian)]

pub fn to_string(value: Party) -> String {
  case value {
    Player -> "player"
    Guardian -> "guardian"
  }
}

pub fn from_string(value: String) -> Result(Party, Nil) {
  case value {
    "player" -> Ok(Player)
    "guardian" -> Ok(Guardian)
    _ -> Error(Nil)
  }
}

/// The text the column stores, as JSON.
pub fn to_json(value: Party) -> Json {
  json.string(to_string(value))
}

/// Text outside the vocabulary fails loudly: the table's CHECK should make it impossible.
pub fn decoder() -> decode.Decoder(Party) {
  use value <- decode.then(decode.string)
  case from_string(value) {
    Ok(v) -> decode.success(v)
    Error(Nil) -> decode.failure(Player, "Party")
  }
}


