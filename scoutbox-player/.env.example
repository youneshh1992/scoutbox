# Backend the app talks to (default http://localhost:4000).
# For a physical phone on the same Wi-Fi, use your machine's LAN address:
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Explicit standalone demo (in-browser data, clearly labelled). Leave unset
# for the real, connected application.
EXPO_PUBLIC_DEMO=
