{
  // Type checking only: Node runs the .ts files itself by stripping their types, so nothing is ever emitted.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Only syntax Node can strip: no enums, namespaces or parameter properties.
    "erasableSyntaxOnly": true,
    // A type-only import must say so, or Node would look for it at run time.
    "verbatimModuleSyntax": true,
    "strict": true,
    // The .ts files import modules still in JavaScript, which are typed by inference and not checked themselves.
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.mts"],
  "exclude": ["node_modules", "data", "public"]
}
